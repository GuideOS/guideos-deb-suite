    def on_select_folder(self, button):
        dialog = Gtk.FileDialog(title='Projektordner auswählen')
        dialog.select_folder(self, None, self._on_folder_selected)

    def _on_folder_selected(self, dialog, result):
        try:
            folder = dialog.select_folder_finish(result)
            if folder:
                self.project_dir = Path(folder.get_path())
                self.folder_row.set_subtitle(str(self.project_dir))

                base_name = self.project_dir.name.lower().replace('_', '-')
                self.entry_pkg.set_text(base_name)
                self.entry_app_id.set_text(f"org.guideos.{base_name.replace('-', '')}")

                py_files = list(self.project_dir.glob('*.py'))
                if py_files:
                    self.selected_script_path = py_files[0]
                    self.row_desktop_script.set_subtitle(self.selected_script_path.name)

                png_files = list(self.project_dir.glob('*.png'))
                if png_files:
                    self.entry_desktop_icon.set_text(png_files[0].stem)
                else:
                    self.entry_desktop_icon.set_text(base_name)

                auto_deps = detect_python_dependencies(self.project_dir)
                self.entry_deps.set_text(', '.join(auto_deps))

                self.build_btn.set_sensitive(True)
        except Exception as e:
            self.status_row.set_subtitle(f'Fehler: {e}')

    def on_select_pngs(self, button):
        dialog = Gtk.FileDialog(title='PNG Icon(s) auswählen')

        if self.project_dir and self.project_dir.exists():
            gfile = Gio.File.new_for_path(str(self.project_dir))
            dialog.set_initial_folder(gfile)

        filter_png = Gtk.FileFilter()
        filter_png.set_name('PNG Bilder')
        filter_png.add_mime_type('image/png')

        filters = Gio.ListStore.new(Gtk.FileFilter)
        filters.append(filter_png)
        dialog.set_filters(filters)

        dialog.open_multiple(self, None, self._on_pngs_selected)

    def _on_pngs_selected(self, dialog, result):
        try:
            files = dialog.open_multiple_finish(result)
            if files:
                self.custom_png_files = [Path(f.get_path()) for f in files]
                count = len(self.custom_png_files)
                self.row_png_select.set_subtitle(
                    f'{count} PNG-Datei(en) manuell ausgewählt'
                )
                if self.custom_png_files:
                    self.entry_desktop_icon.set_text(self.custom_png_files[0].stem)
        except Exception:
            pass

    def on_select_script(self, button):
        dialog = Gtk.FileDialog(title='Haupt-Skript auswählen')

        if self.project_dir and self.project_dir.exists():
            gfile = Gio.File.new_for_path(str(self.project_dir))
            dialog.set_initial_folder(gfile)

        filter_all = Gtk.FileFilter()
        filter_all.set_name('Alle Dateien (Skripte ohne Endung)')
        filter_all.add_pattern('*')

        filter_py = Gtk.FileFilter()
        filter_py.set_name('Python Skripte (*.py)')
        filter_py.add_pattern('*.py')

        filters = Gio.ListStore.new(Gtk.FileFilter)
        filters.append(filter_all)
        filters.append(filter_py)
        dialog.set_filters(filters)

        dialog.open(self, None, self._on_script_selected)

    def _on_script_selected(self, dialog, result):
        try:
            file = dialog.open_finish(result)
            if file:
                self.selected_script_path = Path(file.get_path())
                self.row_desktop_script.set_subtitle(self.selected_script_path.name)
        except Exception:
            pass

    def generate_desktop_file(self, pkg_name: str, exec_name: str, desc: str) -> Path:
        """Erstellt eine valide .desktop-Datei im Projektverzeichnis."""
        icon_name = self.entry_desktop_icon.get_text().strip() or pkg_name
        name_de = self.entry_desktop_name_de.get_text().strip() or desc
        app_type = self.entry_desktop_type.get_text().strip() or 'Application'
        categories = (
            self.entry_desktop_categories.get_text().strip() or 'Utility;'
        )
        terminal_str = (
            'true' if self.switch_desktop_terminal.get_active() else 'false'
        )

        content = f"""[Desktop Entry]
Version=1.0
Type={app_type}
Name={pkg_name}
Name[de]={name_de}
Comment={desc}
Exec={exec_name}
Icon={icon_name}
Terminal={terminal_str}
StartupNotify=true
Categories={categories}
StartupWMClass={exec_name}
"""
        desktop_file_path = self.project_dir / f'{pkg_name}.desktop'
        desktop_file_path.write_text(content, encoding='utf-8')
        return desktop_file_path

    def generate_appstream_file(self, pkg_name: str, desc: str) -> Path:
        """Erstellt eine AppStream Metainfo XML-Datei im Projektverzeichnis."""
        app_id = self.entry_app_id.get_text().strip() or f"org.guideos.{pkg_name}"
        license_type = self.entry_app_license.get_text().strip() or "MIT"
        icon_name = self.entry_desktop_icon.get_text().strip() or pkg_name

        content = f"""<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>{app_id}</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>{license_type}</project_license>
  <name>{pkg_name}</name>
  <summary>{desc}</summary>
  <description>
    <p>
      {desc}
    </p>
  </description>
  <launchable type="desktop-id">{pkg_name}.desktop</launchable>
  <icon type="stock">{icon_name}</icon>
</component>
"""
        appstream_path = self.project_dir / f'{app_id}.metainfo.xml'
        appstream_path.write_text(content, encoding='utf-8')
        return appstream_path

    def convert_icons_and_update_install(
        self, install_lines: list
    ) -> set:
        png_files = (
            self.custom_png_files
            if self.custom_png_files
            else list(self.project_dir.glob('*.png'))
        )

        processed_png_names = set()
        if not png_files:
            return processed_png_names

        icons_dir = self.project_dir / 'icons'
        icons_dir.mkdir(exist_ok=True)

        for png_file in png_files:
            svg_name = f'{png_file.stem}.svg'
            svg_path = icons_dir / svg_name

            vectorize_image_inkscape(png_file, svg_path)

            rel_svg = svg_path.relative_to(self.project_dir)
            install_lines.append(f'{rel_svg}\tusr/share/icons/hicolor/scalable/apps')

            processed_png_names.add(png_file.name)

        return processed_png_names

    def create_maintainer_scripts(self, debian_dir: Path):
        """Erzeugt postinst und postrm für Icon- und Menü-Aktualisierung."""
        script_content = """#!/bin/sh
set -e

if [ -x /usr/bin/gtk-update-icon-cache ]; then
    gtk-update-icon-cache -f -q /usr/share/icons/hicolor || true
fi

if [ -x /usr/bin/update-desktop-database ]; then
    update-desktop-database -q /usr/share/applications || true
fi

if [ -x /usr/bin/appstreamcli ]; then
    appstreamcli refresh-cache --force || true
fi

#DEBHELPER#
exit 0
"""
        for hook_name in ['postinst', 'postrm']:
            hook_file = debian_dir / hook_name
            hook_file.write_text(script_content, encoding='utf-8')
            hook_file.chmod(0o755)

    def generate_debian_structure(self, pkg, maint, section, deps, desc):
        deb_dir = self.project_dir / 'debian'
        source_dir = deb_dir / 'source'
        source_dir.mkdir(parents=True, exist_ok=True)

        # 1. debian/control
        control_content = f"""Source: {pkg}
Section: {section}
Priority: optional
Maintainer: {maint}
Build-Depends: debhelper-compat (= 13)
Standards-Version: 4.7.0

Package: {pkg}
Architecture: all
Depends: {deps}
Description: {desc}
 Paket wurde automatisch mit der GuideOS DEB Suite erstellt.
"""
        (deb_dir / 'control').write_text(control_content, encoding='utf-8')

        # 2. Simple debian/rules
        rules_content = "#!/usr/bin/make -f\n%:\n\tdh $@\n"
        rules_file = deb_dir / 'rules'
        rules_file.write_text(rules_content, encoding='utf-8')
        rules_file.chmod(
            stat.S_IRWXU | stat.S_IRGRP | stat.S_IXGRP | stat.S_IROTH
        )

        (source_dir / 'format').write_text('3.0 (native)\n', encoding='utf-8')

        # 3. Haupt-Skript für usr/bin vorbereiten
        exec_name = pkg
        if self.selected_script_path:
            exec_name = (
                self.selected_script_path.stem
                if self.selected_script_path.suffix == '.py'
                else self.selected_script_path.name
            )

            bin_target_file = self.project_dir / exec_name
            if self.selected_script_path != bin_target_file:
                shutil.copy2(self.selected_script_path, bin_target_file)
                bin_target_file.chmod(bin_target_file.stat().st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)

        install_lines = []
        converted_pngs = set()

        # Build-Eintrag für die Haupt-Binärdatei
        install_lines.append(f'{exec_name}\tusr/bin/')

        # Icons verarbeiten
        if self.switch_vectorize.get_active():
            converted_pngs = self.convert_icons_and_update_install(install_lines)

        # .desktop Datei erzeugen
        if self.switch_desktop.get_active():
            self.generate_desktop_file(pkg, exec_name, desc)
            install_lines.append(f'{pkg}.desktop\tusr/share/applications/')

        # AppStream-Metainfo erzeugen
        if self.switch_appstream.get_active():
            appstream_file = self.generate_appstream_file(pkg, desc)
            install_lines.append(f'{appstream_file.name}\tusr/share/metainfo/')

        # Postinst/Postrm erstellen
        self.create_maintainer_scripts(deb_dir)

        # Weitere Dateien im Ordner erfassen
        ignored_files = {
            'LICENSE', 'README.md', 'guideos-icon-converter.py', exec_name
        }

        for item in self.project_dir.iterdir():
            if item.is_file():
                name = item.name

                if (
                    name in converted_pngs
                    or name in ignored_files
                    or name.startswith('.')
                    or name.endswith('.deb')
                    or name.endswith('.sha256')
                    or name.endswith('.desktop')
                    or name.endswith('.metainfo.xml')
                ):
                    continue

                if name.endswith('.png') and not self.switch_vectorize.get_active():
                    install_lines.append(f'{name}\tusr/share/pixmaps/')
                elif name.endswith('.py') and item != self.selected_script_path:
                    install_lines.append(f'{name}\tusr/lib/{pkg}/')

        # 4. Erstelle saubere debian/install
        (deb_dir / 'install').write_text(
            '\n'.join(install_lines) + '\n', encoding='utf-8'
        )

        changelog_content = f"""{pkg} (1.0.0) unstable; urgency=medium

  * Automatisches Release via GuideOS Builder.

 -- {maint}  Wed, 19 Aug 2026 12:00:00 +0200
"""
        (deb_dir / 'changelog').write_text(changelog_content, encoding='utf-8')

    def calculate_sha256(self, filepath: Path) -> str:
        sha = hashlib.sha256()
        with open(filepath, 'rb') as f:
            for block in iter(lambda: f.read(4096), b''):
                sha.update(block)
        return sha.hexdigest()

    def on_start_process(self, button):
        if not self.project_dir:
            return

        self.status_row.set_subtitle('Prüfe Build-Werkzeuge...')
        ok, err_msg = check_and_install_build_tools()
        if not ok:
            self.status_row.set_subtitle('❌ Werkzeuge fehlen')
            self.show_error_dialog("Fehlende Build-Werkzeuge", err_msg)
            return

        pkg = self.entry_pkg.get_text().strip()
        maint = self.entry_maint.get_text().strip()

        section_raw = self.entry_section.get_text().strip()
        section = section_raw.split(',')[0].strip() if ',' in section_raw else section_raw

        deps = self.entry_deps.get_text().strip()
        desc = self.entry_desc.get_text().strip()

        try:
            self.status_row.set_subtitle('Generiere debian/-Struktur & Vektorisiere Icons...')

            self.generate_debian_structure(pkg, maint, section, deps, desc)

            self.status_row.set_subtitle('Starte dpkg-buildpackage...')
            cmd = ['dpkg-buildpackage', '-us', '-uc', '-b']

            res = subprocess.run(
                cmd, cwd=self.project_dir, capture_output=True, text=True
            )

            if res.returncode != 0:
                raise RuntimeError(f"dpkg-buildpackage fehlgeschlagen:\n\nSTDOUT:\n{res.stdout}\n\nSTDERR:\n{res.stderr}")

            parent_dir = self.project_dir.parent
            deb_file = None
            for f in parent_dir.glob('*.deb'):
                if f.name.startswith(pkg):
                    deb_file = f
                    break

            if deb_file and deb_file.exists():
                self.created_deb_path = deb_file
                sha = self.calculate_sha256(deb_file)

                # 1. SHA-256 in eine .sha256 Datei neben der .deb speichern
                sha_file = deb_file.parent / f"{deb_file.name}.sha256"
                sha_file.write_text(f"{sha}  {deb_file.name}\n", encoding='utf-8')

                # 2. UI aktualisieren & Kopier-Button aktivieren
                self.status_row.set_subtitle(f'✓ Paket erstellt: {deb_file.name}')
                self.sha_row.set_subtitle(sha)
                self.btn_copy_sha.set_sensitive(True)

                self.btn_open_folder.set_sensitive(True)
            else:
                self.status_row.set_subtitle('Build beendet, aber keine .deb-Datei gefunden.')

        except Exception as e:
            self.status_row.set_subtitle('❌ Fehler beim Bauen')
            self.show_error_dialog("Fehler beim Erstellen des Pakets", str(e))


class App(Adw.Application):

    def __init__(self):
        super().__init__(
            application_id='de.guideos.DebBuilder',
            flags=Gio.ApplicationFlags.FLAGS_NONE,
        )

    def do_activate(self):
        win = self.props.active_window
        if not win:
            win = GuideosDebBuilderWindow(application=self)
        win.present()


if __name__ == '__main__':
    App().run(None)
