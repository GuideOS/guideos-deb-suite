def check_and_install_build_tools() -> tuple[bool, str]:
    """Prüft, ob die notwendigen Build-Werkzeuge installiert sind."""
    required_packages = [
        "dpkg-dev",
        "debhelper",
        "build-essential",
        "dh-python",
        "desktop-file-utils",
        "appstream",
        "inkscape"
    ]
    missing_packages = []

    for pkg in required_packages:
        res = subprocess.run(["dpkg", "-s", pkg], capture_output=True, text=True)
        if res.returncode != 0:
            missing_packages.append(pkg)

    if not missing_packages:
        return True, ""

    pkgs_str = " ".join(missing_packages)
    cmd = [
        "pkexec", "sh", "-c",
        f"apt-get update && apt-get install -y {pkgs_str}"
    ]

    try:
        res = subprocess.run(cmd, capture_output=True, text=True)
        if res.returncode == 0:
            return True, ""
        else:
            return False, f"Fehler bei der Installation von {pkgs_str}:\n{res.stderr}"
    except Exception as e:
        return False, f"Fehler beim Aufruf von pkexec:\n{str(e)}"


def detect_python_dependencies(project_dir: Path) -> list[str]:
    """Scannt Python-Dateien im Projektordner nach Importen."""
    detected_modules = set()

    for py_file in project_dir.glob('*.py'):
        try:
            tree = ast.parse(py_file.read_text(encoding='utf-8'))
            for node in ast.walk(tree):
                if isinstance(node, ast.Import):
                    for alias in node.names:
                        detected_modules.add(alias.name.split('.')[0])
                elif isinstance(node, ast.ImportFrom):
                    if node.module:
                        detected_modules.add(node.module.split('.')[0])
        except Exception:
            continue

    mapping = {
        'PyQt6': 'python3-pyqt6',
        'PyQt5': 'python3-pyqt5',
        'gi': 'python3-gi',
        'requests': 'python3-requests',
        'PIL': 'python3-pil',
        'numpy': 'python3-numpy',
        'pandas': 'python3-pandas',
        'cv2': 'python3-opencv',
    }

    deps = ['python3']
    for mod, pkg in mapping.items():
        if mod in detected_modules and pkg not in deps:
            deps.append(pkg)

    deps.append('${misc:Depends}')
    return deps


def vectorize_image_inkscape(input_path: Path, output_path: Path):
    """Vektorisiert ein PNG zu SVG via Inkscape CLI."""
    inkscape_bin = '/usr/bin/inkscape'
    if not os.path.exists(inkscape_bin):
        raise RuntimeError(
            "Das Paket 'inkscape' wurde nicht gefunden.\n"
            "Bitte 'sudo apt install inkscape' ausführen."
        )

    res = subprocess.run(
        [
            inkscape_bin,
            str(input_path),
            '--export-type=svg',
            f'--export-filename={output_path}',
        ],
        capture_output=True,
        text=True,
    )

    if res.returncode != 0:
        raise RuntimeError(f'Inkscape Fehler:\n{res.stderr}')


